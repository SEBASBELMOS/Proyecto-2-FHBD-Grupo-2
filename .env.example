# Copy to .env (git-ignored). All values are optional.

# UID used by Airflow/Jupyter containers (Linux hosts: output of `id -u`).
AIRFLOW_UID=50000

# Base image for Dockerfile.airflow. Override it only to reuse an Airflow 2.10.3 image
# that is already available locally.
# AIRFLOW_BASE_IMAGE=apache/airflow:2.10.3-python3.10

# MinIO server and client images. Override them to use another MinIO-compatible image or fork.
# MINIO_IMAGE=quay.io/minio/minio:RELEASE.2025-09-07T16-13-09Z
# MINIO_MC_IMAGE=quay.io/minio/mc:RELEASE.2025-08-13T08-35-41Z

# Airflow web user
# _AIRFLOW_WWW_USER_USERNAME=airflow
# _AIRFLOW_WWW_USER_PASSWORD=airflow
